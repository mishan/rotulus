# gi-docgen's configuration for the C and GObject API reference. Meson
# fills in the version and runs it over the introspection data; see the
# documentation option.

[library]
version = "@version@"
browse_url = "https://github.com/mishan/rotulus"
repository_url = "https://github.com/mishan/rotulus.git"
website_url = "https://github.com/mishan/rotulus"
authors = "Misha Nasledov"
license = "LGPL-2.1-or-later"
description = "A GTK4 scrollback view for text-stream chat"
dependencies = ["Gtk-4.0", "Gdk-4.0", "GObject-2.0", "GLib-2.0"]
devhelp = true
search_index = true

  [dependencies."Gtk-4.0"]
  name = "GTK"
  description = "The GTK toolkit"
  docs_url = "https://docs.gtk.org/gtk4/"

  [dependencies."Gdk-4.0"]
  name = "GDK"
  description = "The GTK windowing system abstraction"
  docs_url = "https://docs.gtk.org/gdk4/"

  [dependencies."GObject-2.0"]
  name = "GObject"
  description = "The base type system library"
  docs_url = "https://docs.gtk.org/gobject/"

  [dependencies."GLib-2.0"]
  name = "GLib"
  description = "The base utility library"
  docs_url = "https://docs.gtk.org/glib/"

[theme]
name = "basic"
show_index_summary = true
show_class_hierarchy = true

[source-location]
base_url = "https://github.com/mishan/rotulus/blob/main/"

[extra]
content_files = ["overview.md"]
urlmap_file = "urlmap.js"
